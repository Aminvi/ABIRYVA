# Configure these in Vercel Project Settings → Environment Variables, then redeploy.
# Never commit actual API keys. Use a verified Resend sender domain.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=info@abiryva.com

# Shared verification code storage (Upstash Redis REST credentials).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client portal: create a Clerk application; invite-only sign-up is recommended.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user IDs for authorised Abiryva staff.
PORTAL_ADMIN_USER_IDS=
# Set true only after enabling MFA in Clerk; owner selected email codes initially.
PORTAL_REQUIRE_STAFF_MFA=false
# Optional namespace; defaults isolate development, preview branch and production.
APP_DATA_NAMESPACE=
